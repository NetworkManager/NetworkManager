/*
 * All NM_DEVICE_* constants (including the per-subtype ones like
 * NM_DEVICE_WIFI_*) are placed on the base NM.Device class by this single
 * catch-all. vapigen applies metadata rules in order with the last match
 * winning, so any per-subtype rule listed here would be shadowed by this
 * one and have no effect (vapigen warns "argument never used" about it).
 */
DEVICE_*                    parent="NM.Device"                      name="DEVICE_(.+)"

ETHTOOL_OPTNAME_*           parent="NM.EthtoolOptname"              name="ETHTOOL_OPTNAME_(.+)"
ethtool_optname_*           parent="NM.EthtoolOptname"              name="ethtool_optname_(.+)"

VLAN_FLAGS_ALL              parent="NM.VlanFlags"                   name="ALL" type="NM.VlanFlags"
