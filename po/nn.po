#: src/nmcli/devices.c:855
msgid ""
"Usage: nmcli device { COMMAND | help }\n"
"\n"
"COMMAND := { status | show | set | connect | reapply | modify | disconnect | "
"delete | monitor | wifi | lldp }\n"
"\n"
"  status\n"
"\n"
"  show [<ifname>]\n"
"\n"
"  set [ifname] <ifname> [autoconnect yes|no] [managed [--permanent|--"
"permanent-only] yes|no|up|down|reset]\n"
"\n"
"  connect <ifname>\n"
"\n"
"  reapply <ifname>\n"
"\n"
"  modify <ifname> ([+|-]<setting>.<property> <value>)+\n"
"\n"
"  disconnect <ifname> ...\n"
"\n"
"  delete <ifname> ...\n"
"\n"
"  monitor <ifname> ...\n"
"\n"
"  wifi [list [ifname <ifname>] [bssid <BSSID>] [--rescan yes|no|auto]]\n"
"\n"
"  wifi connect <(B)SSID> [password <password>] [wep-key-type key|phrase] "
"[ifname <ifname>]\n"
"                         [bssid <BSSID>] [name <name>] [private yes|no] "
"[hidden yes|no]\n"
"\n"
"  wifi hotspot [ifname <ifname>] [con-name <name>] [ssid <SSID>] [band a|bg|"
"6GHz] [channel <channel>] [password <password>]\n"
"\n"
"  wifi rescan [ifname <ifname>] [[ssid <SSID to scan>] ...]\n"
"\n"
"  wifi show-password [ifname <ifname>]\n"
"\n"
"  lldp [list [ifname <ifname>]]\n"
"\n"
msgstr ""
"Bruk: nmcli device { COMMAND | help }\n"
"\n"
"COMMAND := { status | show | set | connect | reapply | modify | disconnect | delete | monitor | wifi | lldp }\n"
"\n"
"  status\n"
"\n"
"  show [<ifname>]\n"
"\n"
"  set [ifname] <ifname> [autoconnect yes|no] [managed [--permanent|--permanent-only] yes|no|up|down|reset]\n"
"\n"
"  connect <ifname>\n"
"\n"
"  reapply <ifname>\n"
"\n"
"  modify <ifname> ([+|-]<setting>.<property> <value>)+\n"
"\n"
"  disconnect <ifname> ...\n"
"\n"
"  delete <ifname> ...\n"
"\n"
"  monitor <ifname> ...\n"
"\n"
"  wifi [list [ifname <ifname>] [bssid <BSSID>] [--rescan yes|no|auto]]\n"
"\n"
"  wifi connect <(B)SSID> [password <password>] [wep-key-type key|phrase] [ifname <ifname>]\n"
"                         [bssid <BSSID>] [name <name>] [private yes|no] [hidden yes|no]\n"
"\n"
"  wifi hotspot [ifname <ifname>] [con-name <name>] [ssid <SSID>] [band a|bg|6GHz] [channel <channel>] [password <password>]\n"
"\n"
"  wifi rescan [ifname <ifname>] [[ssid <SSID to scan>] ...]\n"
"\n"
"  wifi show-password [ifname <ifname>]\n"
"\n"
"  lldp [list [ifname <ifname>]]\n"
"\n"

#: src/nmcli/devices.c:884
msgid ""
"Usage: nmcli device status { help }\n"
"\n"
"Show status for all devices.\n"
"By default, the following columns are shown:\n"
" DEVICE     - interface name\n"
" TYPE       - device type\n"
" STATE      - device state\n"
" CONNECTION - connection activated on device (if any)\n"
"Displayed columns can be changed using '--fields' global option. 'status' "
"is\n"
"the default command, which means 'nmcli device' calls 'nmcli device "
"status'.\n"
"\n"
msgstr ""
"Bruk: nmcli device status { help }\n"
"\n"
"Vis status for alle einingar.\n"
"Som standard vert desse kolonnane viste:\n"
" DEVICE     - grensesnittnamn\n"
" TYPE       - einingstype\n"
" STATE      - einingstilstand\n"
" CONNECTION - tilkopling som er aktivert på eininga (om nokon)\n"
"Kva kolonnar som vert viste, kan endrast med det globale valet '--fields'. 'status' er\n"
"standardkommandoen, som tyder at 'nmcli device' kallar 'nmcli device status'.\n"
"\n"

#: src/nmcli/devices.c:899
msgid ""
"Usage: nmcli device show { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [<ifname>]\n"
"\n"
"Show details of device(s).\n"
"The command lists details for all devices, or for a given device.\n"
"\n"
msgstr ""
"Bruk: nmcli device show { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [<ifname>]\n"
"\n"
"Vis detaljar om eining(ar).\n"
"Kommandoen listar opp detaljar for alle einingar eller for ei bestemt eining.\n"
"\n"

#: src/nmcli/devices.c:910
msgid ""
"Usage: nmcli device connect { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname>\n"
"\n"
"Connect the device.\n"
"NetworkManager will try to find a suitable connection that will be "
"activated.\n"
"It will also consider connections that are not set to auto-connect.\n"
"\n"
msgstr ""
"Bruk: nmcli device connect { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname>\n"
"\n"
"Kople til eininga.\n"
"NetworkManager prøver å finne ei passande tilkopling som vert aktivert.\n"
"Han vurderer òg tilkoplingar som ikkje er sette til autotilkopling.\n"
"\n"

#: src/nmcli/devices.c:922
msgid ""
"Usage: nmcli device reapply { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname>\n"
"\n"
"Attempts to update device with changes to the currently active connection\n"
"made since it was last applied.\n"
"\n"
msgstr ""
"Bruk: nmcli device reapply { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname>\n"
"\n"
"Prøver å oppdatere eininga med endringar i den aktive tilkoplinga\n"
"som er gjorde sidan ho sist vart teken i bruk.\n"
"\n"

#: src/nmcli/devices.c:934
msgid ""
"Usage: nmcli device modify { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname> ([+|-]<setting>.<property> <value>)+\n"
"\n"
"Modify one or more properties that are currently active on the device "
"without modifying\n"
"the connection profile. The changes have immediate effect. For multi-valued\n"
"properties you can use optional '+' or '-' prefix to the property name.\n"
"The '+' sign allows appending items instead of overwriting the whole value.\n"
"The '-' sign allows removing selected items instead of the whole value.\n"
"\n"
"Examples:\n"
"nmcli dev mod em1 ipv4.method manual ipv4.addr \"192.168.1.2/24, "
"10.10.1.5/8\"\n"
"nmcli dev mod em1 +ipv4.dns 8.8.4.4\n"
"nmcli dev mod em1 -ipv4.dns 1\n"
"nmcli dev mod em1 -ipv6.addr \"abbe::cafe/56\"\n"
msgstr ""
"Bruk: nmcli device modify { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname> ([+|-]<setting>.<property> <value>)+\n"
"\n"
"Endre éin eller fleire eigenskapar som er aktive på eininga, utan å endre\n"
"tilkoplingsprofilen. Endringane får verknad med ein gong. For eigenskapar med fleire\n"
"verdiar kan du bruke eit valfritt prefiks '+' eller '-' framfor eigenskapsnamnet.\n"
"Teiknet '+' legg til element i staden for å skrive over heile verdien.\n"
"Teiknet '-' fjernar utvalde element i staden for heile verdien.\n"
"\n"
"Døme:\n"
"nmcli dev mod em1 ipv4.method manual ipv4.addr \"192.168.1.2/24, 10.10.1.5/8\"\n"
"nmcli dev mod em1 +ipv4.dns 8.8.4.4\n"
"nmcli dev mod em1 -ipv4.dns 1\n"
"nmcli dev mod em1 -ipv6.addr \"abbe::cafe/56\"\n"

#: src/nmcli/devices.c:954
msgid ""
"Usage: nmcli device disconnect { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname> ...\n"
"\n"
"Disconnect devices.\n"
"The command disconnects the device and prevents it from auto-activating\n"
"further connections without user/manual intervention.\n"
"\n"
msgstr ""
"Bruk: nmcli device disconnect { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname> ...\n"
"\n"
"Kople frå einingar.\n"
"Kommandoen koplar frå eininga og hindrar at ho autoaktiverer\n"
"fleire tilkoplingar utan at brukaren grip inn manuelt.\n"
"\n"

#: src/nmcli/devices.c:966
msgid ""
"Usage: nmcli device delete { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname> ...\n"
"\n"
"Delete the software devices.\n"
"The command removes the interfaces. It only works for software devices\n"
"(like bonds, bridges, etc.). Hardware devices cannot be deleted by the\n"
"command.\n"
"\n"
msgstr ""
"Bruk: nmcli device delete { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := <ifname> ...\n"
"\n"
"Slett programvareeiningane.\n"
"Kommandoen fjernar grensesnitta. Han fungerer berre for programvareeiningar\n"
"(som bindingar, bruer osb.). Maskinvareeiningar kan ikkje slettast med\n"
"kommandoen.\n"
"\n"

#: src/nmcli/devices.c:980
msgid ""
"Usage: nmcli device set { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := DEVICE { PROPERTY [ PROPERTY ... ] }\n"
"DEVICE    := [ifname] <ifname> \n"
"PROPERTY  := { autoconnect { yes | no } |\n"
"             { managed [--permanent | --permanent-only] { yes | no | up | "
"down | reset }\n"
"\n"
"Modify device properties.\n"
"\n"
msgstr ""
"Bruk: nmcli device set { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := DEVICE { PROPERTY [ PROPERTY ... ] }\n"
"DEVICE    := [ifname] <ifname> \n"
"PROPERTY  := { autoconnect { yes | no } |\n"
"             { managed [--permanent | --permanent-only] { yes | no | up | down | reset }\n"
"\n"
"Endre eigenskapar for eininga.\n"
"\n"

#: src/nmcli/devices.c:993
msgid ""
"Usage: nmcli device monitor { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [<ifname>] ...\n"
"\n"
"Monitor device activity.\n"
"This command prints a line whenever the specified devices change state.\n"
"Monitors all devices in case no interface is specified.\n"
"\n"
msgstr ""
"Bruk: nmcli device monitor { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [<ifname>] ...\n"
"\n"
"Overvak aktiviteten til einingar.\n"
"Denne kommandoen skriv ut ei linje kvar gong dei oppgjevne einingane endrar tilstand.\n"
"Overvakar alle einingar dersom inkje grensesnitt er oppgjeve.\n"
"\n"

#: src/nmcli/devices.c:1006
msgid ""
"Usage: nmcli device wifi { ARGUMENTS | help }\n"
"\n"
"Perform operation on Wi-Fi devices.\n"
"\n"
"ARGUMENTS := [list [ifname <ifname>] [bssid <BSSID>] [--rescan yes|no|"
"auto]]\n"
"\n"
"List available Wi-Fi access points. The 'ifname' and 'bssid' options can be\n"
"used to list APs for a particular interface, or with a specific BSSID. The\n"
"--rescan flag tells whether a new Wi-Fi scan should be triggered.\n"
"\n"
"ARGUMENTS := connect <(B)SSID> [password <password>] [wep-key-type key|"
"phrase] [ifname <ifname>]\n"
"                     [bssid <BSSID>] [name <name>] [private yes|no] [hidden "
"yes|no]\n"
"\n"
"Connect to a Wi-Fi network specified by SSID or BSSID. The command finds a\n"
"matching connection or creates one and then activates it on a device. This\n"
"is a command-line counterpart of clicking an SSID in a GUI client. If a\n"
"connection for the network already exists, it is possible to bring up the\n"
"existing profile as follows: nmcli con up id <name>. Note that only open,\n"
"WEP and WPA-PSK networks are supported if no previous connection exists.\n"
"It is also assumed that IP configuration is obtained via DHCP.\n"
"\n"
"ARGUMENTS := hotspot [ifname <ifname>] [con-name <name>] [ssid <SSID>]\n"
"                     [band a|bg|6GHz] [channel <channel>] [password "
"<password>]\n"
"\n"
"Create a Wi-Fi hotspot. Use 'connection down' or 'device disconnect'\n"
"to stop the hotspot.\n"
"Parameters of the hotspot can be influenced by the optional parameters:\n"
"ifname - Wi-Fi device to use\n"
"con-name - name of the created hotspot connection profile\n"
"ssid - SSID of the hotspot\n"
"band - Wi-Fi band to use\n"
"channel - Wi-Fi channel to use\n"
"password - password to use for the hotspot\n"
"\n"
"ARGUMENTS := rescan [ifname <ifname>] [[ssid <SSID to scan>] ...]\n"
"\n"
"Request that NetworkManager immediately re-scan for available access "
"points.\n"
"NetworkManager scans Wi-Fi networks periodically, but in some cases it "
"might\n"
"be useful to start scanning manually. 'ssid' allows scanning for a specific\n"
"SSID, which is useful for APs with hidden SSIDs. More 'ssid' parameters can "
"be\n"
"given. Note that this command does not show the APs,\n"
"use 'nmcli device wifi list' for that.\n"
"\n"
msgstr ""
"Bruk: nmcli device wifi { ARGUMENTS | help }\n"
"\n"
"Utfør operasjonar på Wi-Fi-einingar.\n"
"\n"
"ARGUMENTS := [list [ifname <ifname>] [bssid <BSSID>] [--rescan yes|no|auto]]\n"
"\n"
"List opp tilgjengelege Wi-Fi-tilgangspunkt. Vala 'ifname' og 'bssid' kan\n"
"brukast til å liste opp tilgangspunkt for eit bestemt grensesnitt eller med ein bestemt BSSID.\n"
"Flagget --rescan avgjer om ei ny Wi-Fi-skanning skal startast.\n"
"\n"
"ARGUMENTS := connect <(B)SSID> [password <password>] [wep-key-type key|phrase] [ifname <ifname>]\n"
"                     [bssid <BSSID>] [name <name>] [private yes|no] [hidden yes|no]\n"
"\n"
"Kople til eit Wi-Fi-nettverk oppgjeve med SSID eller BSSID. Kommandoen finn ei\n"
"samsvarande tilkopling eller lagar ei, og aktiverer ho så på ei eining. Dette\n"
"er kommandolinjeutgåva av å klikke på ein SSID i ein grafisk klient. Dersom det\n"
"alt finst ei tilkopling for nettverket, kan den eksisterande profilen\n"
"aktiverast slik: nmcli con up id <name>. Merk at berre opne nettverk,\n"
"WEP- og WPA-PSK-nettverk er støtta dersom det ikkje finst ei tilkopling frå før.\n"
"Det vert òg gått ut frå at IP-oppsettet vert henta via DHCP.\n"
"\n"
"ARGUMENTS := hotspot [ifname <ifname>] [con-name <name>] [ssid <SSID>]\n"
"                     [band a|bg|6GHz] [channel <channel>] [password <password>]\n"
"\n"
"Lag ei Wi-Fi-sone. Bruk 'connection down' eller 'device disconnect'\n"
"for å stoppe Wi-Fi-sona.\n"
"Parametrane til Wi-Fi-sona kan påverkast med desse valfrie parametrane:\n"
"ifname - Wi-Fi-eininga som skal brukast\n"
"con-name - namnet på tilkoplingsprofilen som vert laga for Wi-Fi-sona\n"
"ssid - SSID-en til Wi-Fi-sona\n"
"band - Wi-Fi-bandet som skal brukast\n"
"channel - Wi-Fi-kanalen som skal brukast\n"
"password - passordet for Wi-Fi-sona\n"
"\n"
"ARGUMENTS := rescan [ifname <ifname>] [[ssid <SSID to scan>] ...]\n"
"\n"
"Be NetworkManager skanne etter tilgjengelege tilgangspunkt på nytt med ein gong.\n"
"NetworkManager skannar Wi-Fi-nettverk med jamne mellomrom, men i somme tilfelle kan\n"
"det vere nyttig å starte skanninga manuelt. 'ssid' gjer det mogleg å skanne etter ein bestemt\n"
"SSID, noko som er nyttig for tilgangspunkt med skjult SSID. Fleire 'ssid'-parametrar kan\n"
"gjevast. Merk at denne kommandoen ikkje viser tilgangspunkta;\n"
"bruk 'nmcli device wifi list' til det.\n"
"\n"

#: src/nmcli/devices.c:1054
msgid ""
"Usage: nmcli device lldp { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [list [ifname <ifname>]]\n"
"\n"
"List neighboring devices discovered through LLDP. The 'ifname' option can "
"be\n"
"used to list neighbors for a particular interface.\n"
"\n"
msgstr ""
"Bruk: nmcli device lldp { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [list [ifname <ifname>]]\n"
"\n"
"List opp naboeiningar som er funne gjennom LLDP. Valet 'ifname' kan\n"
"brukast til å liste opp naboar for eit bestemt grensesnitt.\n"
"\n"

#: src/nmcli/devices.c:1065
msgid ""
"Usage: nmcli device checkpoint { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [--timeout <seconds>] -- COMMAND...\n"
"\n"
"Runs the command with a configuration checkpoint taken and asks for a\n"
"confirmation when finished. When the confirmation is not given, the\n"
"checkpoint is automatically restored after timeout.\n"
"\n"
msgstr ""
"Bruk: nmcli device checkpoint { ARGUMENTS | help }\n"
"\n"
"ARGUMENTS := [--timeout <seconds>] -- COMMAND...\n"
"\n"
"Køyrer kommandoen med eit kontrollpunkt for oppsettet og ber om\n"
"stadfesting når han er ferdig. Dersom stadfesting ikkje vert gjeven, vert\n"
"kontrollpunktet automatisk gjenoppretta etter tidsavbrotet.\n"
"\n"

