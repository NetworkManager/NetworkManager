#: data/org.freedesktop.NetworkManager.policy.in:13
msgid "Enable or disable system networking"
msgstr "Slå på eller av systemnettverk"

#: data/org.freedesktop.NetworkManager.policy.in:14
msgid "System policy prevents enabling or disabling system networking"
msgstr "Systempolicy hindrar å slå på eller av systemnettverk"

#: data/org.freedesktop.NetworkManager.policy.in:22
msgid "Reload NetworkManager configuration"
msgstr "Last inn oppsettet til NetworkManager på nytt"

#: data/org.freedesktop.NetworkManager.policy.in:23
msgid "System policy prevents reloading NetworkManager"
msgstr "Systempolicy hindrar at NetworkManager vert lasta inn på nytt"

#: data/org.freedesktop.NetworkManager.policy.in:32
msgid ""
"Put NetworkManager to sleep or wake it up (should only be used by system "
"power management)"
msgstr ""
"Set NetworkManager i kvilemodus eller vekk han (bør berre brukast av "
"straumstyringa i systemet)"

#: data/org.freedesktop.NetworkManager.policy.in:33
msgid "System policy prevents putting NetworkManager to sleep or waking it up"
msgstr ""
"Systempolicy hindrar å setje NetworkManager i kvilemodus eller vekkje han"

#: data/org.freedesktop.NetworkManager.policy.in:41
msgid "Enable or disable Wi-Fi devices"
msgstr "Slå på eller av Wi-Fi-einingar"

#: data/org.freedesktop.NetworkManager.policy.in:42
msgid "System policy prevents enabling or disabling Wi-Fi devices"
msgstr "Systempolicy hindrar å slå Wi-Fi-einingar på eller av"

#: data/org.freedesktop.NetworkManager.policy.in:50
msgid "Enable or disable mobile broadband devices"
msgstr "Slå einingar for mobilt breiband på eller av"

#: data/org.freedesktop.NetworkManager.policy.in:51
msgid "System policy prevents enabling or disabling mobile broadband devices"
msgstr "Systempolicy hindrar å slå einingar for mobilt breiband på eller av"

#: data/org.freedesktop.NetworkManager.policy.in:59
msgid "Enable or disable WiMAX mobile broadband devices"
msgstr "Slå WiMAX-einingar for mobilt breiband på eller av"

#: data/org.freedesktop.NetworkManager.policy.in:60
msgid ""
"System policy prevents enabling or disabling WiMAX mobile broadband devices"
msgstr ""
"Systempolicy hindrar å slå WiMAX-einingar for mobilt breiband på eller av"

#: data/org.freedesktop.NetworkManager.policy.in:68
msgid "Allow control of network connections"
msgstr "Tillat kontroll over nettverkstilkoplingar"

#: data/org.freedesktop.NetworkManager.policy.in:69
msgid "System policy prevents control of network connections"
msgstr "Systempolicy hindrar kontroll over nettverkstilkoplingar"

#: data/org.freedesktop.NetworkManager.policy.in:78
msgid "Allow control of Wi-Fi scans"
msgstr "Tillat kontroll over Wi-Fi-skanning"

#: data/org.freedesktop.NetworkManager.policy.in:79
msgid "System policy prevents Wi-Fi scans"
msgstr "Systempolicy hindrar Wi-Fi-skanning"

#: data/org.freedesktop.NetworkManager.policy.in:88
msgid "Connection sharing via a protected Wi-Fi network"
msgstr "Deling av tilkopling via eit verna Wi-Fi-nettverk"

#: data/org.freedesktop.NetworkManager.policy.in:89
msgid ""
"System policy prevents sharing connections via a protected Wi-Fi network"
msgstr ""
"Systempolicy hindrar deling av tilkoplingar via eit verna Wi-Fi-nettverk"

#: data/org.freedesktop.NetworkManager.policy.in:97
msgid "Connection sharing via an open Wi-Fi network"
msgstr "Deling av tilkopling via eit ope Wi-Fi-nettverk"

#: data/org.freedesktop.NetworkManager.policy.in:98
msgid "System policy prevents sharing connections via an open Wi-Fi network"
msgstr ""
"Systempolicy hindrar deling av tilkoplingar via eit ope Wi-Fi-nettverk"

#: data/org.freedesktop.NetworkManager.policy.in:106
msgid "Modify personal network connections"
msgstr "Endre personlege nettverkstilkoplingar"

#: data/org.freedesktop.NetworkManager.policy.in:107
msgid "System policy prevents modification of personal network settings"
msgstr "Systempolicy hindrar endring av personlege nettverksinnstillingar"

#: data/org.freedesktop.NetworkManager.policy.in:116
msgid "Modify network connections for all users"
msgstr "Endre nettverkstilkoplingar for alle brukarar"

#: data/org.freedesktop.NetworkManager.policy.in:117
msgid "System policy prevents modification of network settings for all users"
msgstr ""
"Systempolicy hindrar endring av nettverksinnstillingar for alle brukarar"

#: data/org.freedesktop.NetworkManager.policy.in:126
msgid "Modify persistent system hostname"
msgstr "Endre det varige vertsnamnet til systemet"

#: data/org.freedesktop.NetworkManager.policy.in:127
msgid "System policy prevents modification of the persistent system hostname"
msgstr "Systempolicy hindrar endring av det varige vertsnamnet til systemet"

#: data/org.freedesktop.NetworkManager.policy.in:136
msgid "Modify persistent global DNS configuration"
msgstr "Endre varig globalt DNS-oppsett"

#: data/org.freedesktop.NetworkManager.policy.in:137
msgid ""
"System policy prevents modification of the persistent global DNS "
"configuration"
msgstr "Systempolicy hindrar endring av det varige globale DNS-oppsettet"

#: data/org.freedesktop.NetworkManager.policy.in:146
msgid "Perform a checkpoint or rollback of interfaces configuration"
msgstr ""
"Lag eit kontrollpunkt for grensesnittoppsettet, eller rull det tilbake"

#: data/org.freedesktop.NetworkManager.policy.in:147
msgid "System policy prevents the creation of a checkpoint or its rollback"
msgstr ""
"Systempolicy hindrar oppretting av eit kontrollpunkt eller tilbakerulling "
"til det"

#: data/org.freedesktop.NetworkManager.policy.in:156
msgid "Enable or disable device statistics"
msgstr "Slå på eller av einingsstatistikk"

#: data/org.freedesktop.NetworkManager.policy.in:157
msgid "System policy prevents enabling or disabling device statistics"
msgstr "Systempolicy hindrar å slå på eller av einingsstatistikk"

#: data/org.freedesktop.NetworkManager.policy.in:165
msgid "Enable or disable connectivity checking"
msgstr "Slå kontroll av nettilgang på eller av"

#: data/org.freedesktop.NetworkManager.policy.in:166
msgid "System policy prevents enabling or disabling connectivity checking"
msgstr "Systempolicy hindrar å slå kontroll av nettilgang på eller av"

